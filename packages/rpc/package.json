{
  "name": "@smthrs/rpc",
  "version": "0.0.0",
  "private": true,
  "smthrs": {
    "group": "tooling"
  },
  "type": "module",
  "description": "Contract modules shared by the Smithers native app (apps/app) and the Cloudflare Worker (apps/server): zod schemas, route constants, and RPC types, plus BrowserFetch, the shared browser-tool fetch handler both hosts run",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./fixtures/*": {
      "types": "./test/fixtures/*.ts",
      "default": "./test/fixtures/*.ts"
    },
    "./testing/LiveDocRelay": {
      "types": "./src/testing/LiveDocRelay.ts",
      "default": "./src/testing/LiveDocRelay.ts"
    }
  },
  "scripts": {
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0 && dprint check"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.1",
    "string-width": "7.2.0",
    "zod": "4.5.4",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "dprint": "0.55.2",
    "eslint": "9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "5.0.0"
  }
}
