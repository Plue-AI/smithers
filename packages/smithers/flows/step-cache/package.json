{
  "name": "@smthrs/step-cache",
  "type": "module",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Effect service for the flows content-addressed step result cache",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/step-cache"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "cache",
    "durability"
  ],
  "keywords": [
    "typescript",
    "effect",
    "cache",
    "durability"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./migrations/*": null,
    "./internal/*": null,
    "./*/index": null,
    "./CacheStore": "./src/CacheStore.ts",
    "./CacheStoreMetrics": "./src/CacheStoreMetrics.ts",
    "./CombinedCacheStore": "./src/CombinedCacheStore.ts",
    "./Migrations": "./src/Migrations.ts",
    "./RemoteCacheStore": "./src/RemoteCacheStore.ts",
    "./index": "./src/index.ts",
    "./test/TestCacheStore": "./src/test/TestCacheStore.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./migrations/*": null,
      "./internal/*": null,
      "./*/index": null,
      "./CacheStore": {
        "import": {
          "types": "./dist/esm/CacheStore.d.ts",
          "default": "./dist/esm/CacheStore.js"
        },
        "require": {
          "types": "./dist/cjs/CacheStore.d.ts",
          "default": "./dist/cjs/CacheStore.js"
        }
      },
      "./CacheStoreMetrics": {
        "import": {
          "types": "./dist/esm/CacheStoreMetrics.d.ts",
          "default": "./dist/esm/CacheStoreMetrics.js"
        },
        "require": {
          "types": "./dist/cjs/CacheStoreMetrics.d.ts",
          "default": "./dist/cjs/CacheStoreMetrics.js"
        }
      },
      "./CombinedCacheStore": {
        "import": {
          "types": "./dist/esm/CombinedCacheStore.d.ts",
          "default": "./dist/esm/CombinedCacheStore.js"
        },
        "require": {
          "types": "./dist/cjs/CombinedCacheStore.d.ts",
          "default": "./dist/cjs/CombinedCacheStore.js"
        }
      },
      "./Migrations": {
        "import": {
          "types": "./dist/esm/Migrations.d.ts",
          "default": "./dist/esm/Migrations.js"
        },
        "require": {
          "types": "./dist/cjs/Migrations.d.ts",
          "default": "./dist/cjs/Migrations.js"
        }
      },
      "./RemoteCacheStore": {
        "import": {
          "types": "./dist/esm/RemoteCacheStore.d.ts",
          "default": "./dist/esm/RemoteCacheStore.js"
        },
        "require": {
          "types": "./dist/cjs/RemoteCacheStore.d.ts",
          "default": "./dist/cjs/RemoteCacheStore.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./test/TestCacheStore": {
        "import": {
          "types": "./dist/esm/test/TestCacheStore.d.ts",
          "default": "./dist/esm/test/TestCacheStore.js"
        },
        "require": {
          "types": "./dist/cjs/test/TestCacheStore.d.ts",
          "default": "./dist/cjs/test/TestCacheStore.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "node ../database/scripts/test-matrix.mjs",
    "test:matrix": "node ../database/scripts/test-matrix.mjs"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.1",
    "@smthrs/database": "1.0.0-rc.1"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.115",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.115",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115"
  }
}
