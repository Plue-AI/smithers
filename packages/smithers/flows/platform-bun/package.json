{
  "name": "@smthrs/platform-bun",
  "type": "module",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "smthrs": {
    "group": "engine",
    "privateEffectAdapters": [
      "@effect/platform-bun",
      "@effect/platform-node",
      "@effect/platform-node-shared"
    ]
  },
  "description": "Bun Host bundle for flows: Effect's Bun platform services composed into the closed Host surface",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/platform-bun"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "bun",
    "platform"
  ],
  "keywords": [
    "typescript",
    "effect",
    "bun",
    "platform"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26.4.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./BunFileSystem": "./src/BunFileSystem.ts",
    "./BunHost": "./src/BunHost.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist/vendor/**"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./*/index": null,
      "./BunFileSystem": {
        "import": {
          "types": "./dist/esm/BunFileSystem.d.ts",
          "default": "./dist/esm/BunFileSystem.js"
        },
        "require": {
          "types": "./dist/cjs/BunFileSystem.d.ts",
          "default": "./dist/cjs/BunFileSystem.js"
        }
      },
      "./BunHost": {
        "import": {
          "types": "./dist/esm/BunHost.d.ts",
          "default": "./dist/esm/BunHost.js"
        },
        "require": {
          "types": "./dist/cjs/BunHost.d.ts",
          "default": "./dist/cjs/BunHost.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/jj": "1.0.0-rc.1",
    "@smthrs/kernel": "1.0.0-rc.1",
    "undici": "8.10.2",
    "redis": "6.2.1",
    "@types/ws": "8.18.1",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@smthrs/platform-node": "1.0.0-rc.1",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@eslint/js": "9.39.5",
    "@smthrs/platform-node": "1.0.0-rc.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.115",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0",
    "@smthrs/artifacts": "1.0.0-rc.1"
  }
}
