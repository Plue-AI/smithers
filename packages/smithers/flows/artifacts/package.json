{
  "name": "@smthrs/artifacts",
  "type": "module",
  "version": "1.0.0-rc.4",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Effect service for the Smithers content-addressed artifact store, local and remote",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/artifacts"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "cache",
    "content-addressed"
  ],
  "keywords": [
    "typescript",
    "effect",
    "cache",
    "content-addressed"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./ArtifactBackupLease": "./src/ArtifactBackupLease.ts",
    "./ArtifactStore": "./src/ArtifactStore.ts",
    "./ArtifactStoreMetrics": "./src/ArtifactStoreMetrics.ts",
    "./ArtifactSweep": "./src/ArtifactSweep.ts",
    "./CombinedArtifacts": "./src/CombinedArtifacts.ts",
    "./FileLease": "./src/FileLease.ts",
    "./RemoteArtifacts": "./src/RemoteArtifacts.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./*/index": null,
      "./ArtifactBackupLease": {
        "import": {
          "types": "./dist/esm/ArtifactBackupLease.d.ts",
          "default": "./dist/esm/ArtifactBackupLease.js"
        },
        "require": {
          "types": "./dist/cjs/ArtifactBackupLease.d.ts",
          "default": "./dist/cjs/ArtifactBackupLease.js"
        }
      },
      "./ArtifactStore": {
        "import": {
          "types": "./dist/esm/ArtifactStore.d.ts",
          "default": "./dist/esm/ArtifactStore.js"
        },
        "require": {
          "types": "./dist/cjs/ArtifactStore.d.ts",
          "default": "./dist/cjs/ArtifactStore.js"
        }
      },
      "./ArtifactStoreMetrics": {
        "import": {
          "types": "./dist/esm/ArtifactStoreMetrics.d.ts",
          "default": "./dist/esm/ArtifactStoreMetrics.js"
        },
        "require": {
          "types": "./dist/cjs/ArtifactStoreMetrics.d.ts",
          "default": "./dist/cjs/ArtifactStoreMetrics.js"
        }
      },
      "./ArtifactSweep": {
        "import": {
          "types": "./dist/esm/ArtifactSweep.d.ts",
          "default": "./dist/esm/ArtifactSweep.js"
        },
        "require": {
          "types": "./dist/cjs/ArtifactSweep.d.ts",
          "default": "./dist/cjs/ArtifactSweep.js"
        }
      },
      "./CombinedArtifacts": {
        "import": {
          "types": "./dist/esm/CombinedArtifacts.d.ts",
          "default": "./dist/esm/CombinedArtifacts.js"
        },
        "require": {
          "types": "./dist/cjs/CombinedArtifacts.d.ts",
          "default": "./dist/cjs/CombinedArtifacts.js"
        }
      },
      "./FileLease": {
        "import": {
          "types": "./dist/esm/FileLease.d.ts",
          "default": "./dist/esm/FileLease.js"
        },
        "require": {
          "types": "./dist/cjs/FileLease.d.ts",
          "default": "./dist/cjs/FileLease.js"
        }
      },
      "./RemoteArtifacts": {
        "import": {
          "types": "./dist/esm/RemoteArtifacts.d.ts",
          "default": "./dist/esm/RemoteArtifacts.js"
        },
        "require": {
          "types": "./dist/cjs/RemoteArtifacts.d.ts",
          "default": "./dist/cjs/RemoteArtifacts.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/crypto": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.115",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115"
  }
}
