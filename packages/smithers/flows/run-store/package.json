{
  "name": "@smthrs/run-store",
  "type": "module",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Effect services for flows run state, attempts, and ownership arbitration",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/run-store"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "durability",
    "ownership"
  ],
  "keywords": [
    "typescript",
    "effect",
    "durability",
    "ownership"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./migrations/*": null,
    "./*/index": null,
    "./AttemptStore": "./src/AttemptStore.ts",
    "./Heartbeat": "./src/Heartbeat.ts",
    "./Migrations": "./src/Migrations.ts",
    "./Ownership": "./src/Ownership.ts",
    "./RunStore": "./src/RunStore.ts",
    "./RunStoreMetrics": "./src/RunStoreMetrics.ts",
    "./index": "./src/index.ts",
    "./test/TestRunStore": "./src/test/TestRunStore.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./migrations/*": null,
      "./*/index": null,
      "./AttemptStore": {
        "import": {
          "types": "./dist/esm/AttemptStore.d.ts",
          "default": "./dist/esm/AttemptStore.js"
        },
        "require": {
          "types": "./dist/cjs/AttemptStore.d.ts",
          "default": "./dist/cjs/AttemptStore.js"
        }
      },
      "./Heartbeat": {
        "import": {
          "types": "./dist/esm/Heartbeat.d.ts",
          "default": "./dist/esm/Heartbeat.js"
        },
        "require": {
          "types": "./dist/cjs/Heartbeat.d.ts",
          "default": "./dist/cjs/Heartbeat.js"
        }
      },
      "./Migrations": {
        "import": {
          "types": "./dist/esm/Migrations.d.ts",
          "default": "./dist/esm/Migrations.js"
        },
        "require": {
          "types": "./dist/cjs/Migrations.d.ts",
          "default": "./dist/cjs/Migrations.js"
        }
      },
      "./Ownership": {
        "import": {
          "types": "./dist/esm/Ownership.d.ts",
          "default": "./dist/esm/Ownership.js"
        },
        "require": {
          "types": "./dist/cjs/Ownership.d.ts",
          "default": "./dist/cjs/Ownership.js"
        }
      },
      "./RunStore": {
        "import": {
          "types": "./dist/esm/RunStore.d.ts",
          "default": "./dist/esm/RunStore.js"
        },
        "require": {
          "types": "./dist/cjs/RunStore.d.ts",
          "default": "./dist/cjs/RunStore.js"
        }
      },
      "./RunStoreMetrics": {
        "import": {
          "types": "./dist/esm/RunStoreMetrics.d.ts",
          "default": "./dist/esm/RunStoreMetrics.js"
        },
        "require": {
          "types": "./dist/cjs/RunStoreMetrics.d.ts",
          "default": "./dist/cjs/RunStoreMetrics.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./test/TestRunStore": {
        "import": {
          "types": "./dist/esm/test/TestRunStore.d.ts",
          "default": "./dist/esm/test/TestRunStore.js"
        },
        "require": {
          "types": "./dist/cjs/test/TestRunStore.d.ts",
          "default": "./dist/cjs/test/TestRunStore.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "node ../database/scripts/test-matrix.mjs",
    "test:matrix": "node ../database/scripts/test-matrix.mjs"
  },
  "dependencies": {
    "@smthrs/database": "1.0.0-rc.1",
    "@smthrs/journal": "1.0.0-rc.1",
    "@smthrs/observability": "1.0.0-rc.1",
    "@smthrs/canonical": "1.0.0-rc.1"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.115",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.115",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115"
  }
}
