{
  "name": "@smthrs/build-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare deployment of the hosted smithers build remote cache",
  "license": "MIT",
  "smthrs": {
    "group": "tooling"
  },
  "type": "module",
  "sideEffects": [],
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "check": "tsc -b tsconfig.json --force",
    "deploy": "node scripts/deploy.ts --stage prod",
    "deploy:dev": "node scripts/deploy.ts",
    "plan": "node scripts/deploy.ts --stage prod --dry-run",
    "test": "vitest run",
    "lint": "eslint worker scripts deployment.ts alchemy.run.ts --max-warnings=0 && dprint check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260903.1",
    "@smthrs/build-cli": "1.0.0-rc.4",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.115",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "eslint": "9.39.1",
    "typescript-eslint": "8.65.0",
    "dprint": "0.55.2",
    "aws4fetch": "1.0.20"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.4",
    "@smthrs/targets": "1.0.0-rc.4"
  }
}
