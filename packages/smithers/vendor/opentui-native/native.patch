+
+fn insertUnicodeScalars(eb: *EditBuffer, text: []const u8) !void {
+    var it = (try std.unicode.Utf8View.init(text)).iterator();
+    while (it.nextCodepointSlice()) |scalar| try eb.insertText(scalar);
+}
+
+fn expectUnicodeText(eb: *EditBuffer, expected: []const u8) !void {
+    var out: [256]u8 = undefined;
+    try std.testing.expectEqualStrings(expected, out[0..eb.getText(&out)]);
+}
+
+test "EditBuffer - incremental Unicode preserves scalar order at every insertion" {
+    const pool = gp.initGlobalPool(std.testing.allocator);
+    defer gp.deinitGlobalPool();
+    const link_pool = link.initGlobalLinkPool(std.testing.allocator);
+    defer link.deinitGlobalLinkPool();
+    const eb = try EditBuffer.init(std.testing.allocator, pool, link_pool, .wcwidth, null);
+    defer eb.deinit();
+
+    for ([_][]const u8{ "e\u{0301}x", "😀e\u{0301}👨‍👩‍👧‍👦", "a\u{0301}\u{0327}b", "🏳️‍🌈x", "😀\ne\u{0301}x" }) |text| {
+        try eb.setText("");
+        var it = (try std.unicode.Utf8View.init(text)).iterator();
+        while (it.nextCodepointSlice()) |scalar| {
+            try eb.insertText(scalar);
+            try expectUnicodeText(eb, text[0..it.i]);
+        }
+    }
+}
