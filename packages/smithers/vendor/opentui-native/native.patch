+test "Rope - weighted boundary ties retain existing zero-weight leaves" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const items = [_]WeightedItem{
+        .{ .value = 1, .weight = 0 }, .{ .value = 2, .weight = 3 },
+        .{ .value = 3, .weight = 0 }, .{ .value = 4, .weight = 0 },
+        .{ .value = 5, .weight = 2 }, .{ .value = 6, .weight = 0 },
+    };
+    const Case = struct { offset: u32, left: []const u32, right: []const u32 };
+    for ([_]Case{
+        .{ .offset = 0, .left = &.{1}, .right = &.{ 2, 3, 4, 5, 6 } },
+        .{ .offset = 3, .left = &.{ 1, 2, 3, 4 }, .right = &.{ 5, 6 } },
+        .{ .offset = 5, .left = &.{ 1, 2, 3, 4, 5, 6 }, .right = &.{} },
+    }) |case| {
+        const rope = try WeightedRope.from_slice(arena.allocator(), &items);
+        const splitter = makeWeightedSplitter();
+        const split = try WeightedRope.Node.split_at_weight(rope.root, case.offset, arena.allocator(), rope.empty_leaf, &splitter);
+        try std.testing.expectEqual(case.offset, split.left.metrics().weight());
+        try std.testing.expectEqual(5 - case.offset, split.right.metrics().weight());
+        try std.testing.expectEqual(case.left.len, split.left.count());
+        try std.testing.expectEqual(case.right.len, split.right.count());
+        for (case.left, 0..) |value, index| try std.testing.expectEqual(value, split.left.get(@intCast(index)).?.value);
+        for (case.right, 0..) |value, index| try std.testing.expectEqual(value, split.right.get(@intCast(index)).?.value);
