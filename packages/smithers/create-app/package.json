{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@smthrs/create-app",
  "type": "module",
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "smthrs": {
    "group": "tooling"
  },
  "description": "Declare a Smithers app in one PACKAGE.ts: file-routed flows, panes, and Cloudflare targets",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/create-app"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "scaffolding",
    "router"
  ],
  "keywords": [
    "typescript",
    "effect",
    "scaffolding",
    "router"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "sideEffects": [],
  "bin": {
    "smithers-routes": "./bin/routes.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./package": "./src/package.ts",
    "./ui": "./src/ui.ts",
    "./runtime": "./src/runtime.ts",
    "./worker": "./src/worker.ts",
    "./http": "./src/http.ts",
    "./router": "./src/router.ts",
    "./vite": "./src/vite.ts",
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    },
    "./internal/*": null,
    "./*/index": null,
    "./index": "./src/index.ts",
    "./routesBin": "./src/routesBin.ts"
  },
  "files": [
    "bin/**/*.mjs",
    "src/**/*.ts",
    "template/default/**",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./app": {
        "import": {
          "types": "./dist/esm/app.d.ts",
          "default": "./dist/esm/app.js"
        },
        "require": {
          "types": "./dist/cjs/app.d.ts",
          "default": "./dist/cjs/app.js"
        }
      },
      "./package": {
        "import": {
          "types": "./dist/esm/package.d.ts",
          "default": "./dist/esm/package.js"
        },
        "require": {
          "types": "./dist/cjs/package.d.ts",
          "default": "./dist/cjs/package.js"
        }
      },
      "./ui": {
        "import": {
          "types": "./dist/esm/ui.d.ts",
          "default": "./dist/esm/ui.js"
        },
        "require": {
          "types": "./dist/cjs/ui.d.ts",
          "default": "./dist/cjs/ui.js"
        }
      },
      "./runtime": {
        "import": {
          "types": "./dist/esm/runtime.d.ts",
          "default": "./dist/esm/runtime.js"
        },
        "require": {
          "types": "./dist/cjs/runtime.d.ts",
          "default": "./dist/cjs/runtime.js"
        }
      },
      "./worker": {
        "import": {
          "types": "./dist/esm/worker.d.ts",
          "default": "./dist/esm/worker.js"
        },
        "require": {
          "types": "./dist/cjs/worker.d.ts",
          "default": "./dist/cjs/worker.js"
        }
      },
      "./http": {
        "import": {
          "types": "./dist/esm/http.d.ts",
          "default": "./dist/esm/http.js"
        },
        "require": {
          "types": "./dist/cjs/http.d.ts",
          "default": "./dist/cjs/http.js"
        }
      },
      "./router": {
        "import": {
          "types": "./dist/esm/router.d.ts",
          "default": "./dist/esm/router.js"
        },
        "require": {
          "types": "./dist/cjs/router.d.ts",
          "default": "./dist/cjs/router.js"
        }
      },
      "./vite": {
        "import": {
          "types": "./dist/esm/vite.d.ts",
          "default": "./dist/esm/vite.js"
        },
        "require": {
          "types": "./dist/cjs/vite.d.ts",
          "default": "./dist/cjs/vite.js"
        }
      },
      "./testing": {
        "types": "./dist/esm/testing.d.ts",
        "import": "./dist/esm/testing.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./routesBin": {
        "import": {
          "types": "./dist/esm/routesBin.d.ts",
          "default": "./dist/esm/routesBin.js"
        },
        "require": {
          "types": "./dist/cjs/routesBin.d.ts",
          "default": "./dist/cjs/routesBin.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/agent": "1.0.0-rc.1",
    "@smthrs/capability": "1.0.0-rc.1",
    "@smthrs/engine": "1.0.0-rc.1",
    "@smthrs/flow": "1.0.0-rc.1",
    "@smthrs/harness": "1.0.0-rc.1",
    "@smthrs/model": "1.0.0-rc.1",
    "@smthrs/registry": "1.0.0-rc.1",
    "@smthrs/targets": "1.0.0-rc.1"
  },
  "peerDependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@smthrs/testing": "1.0.0-rc.1",
    "effect": "4.0.0-rc.115",
    "react": "^19.2.8",
    "tsx": "^4.23.13",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    },
    "@effect/platform-node-shared": {
      "optional": true
    },
    "@smthrs/testing": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@smthrs/core": "1.0.0-rc.1",
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@eslint/js": "9.39.5",
    "@smthrs/testing": "1.0.0-rc.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.115",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "react": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
