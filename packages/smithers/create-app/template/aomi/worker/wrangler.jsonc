{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "__APP_NAME__",
	"main": "./index.ts",
	"compatibility_date": "2026-08-01",
	// The agent path imports `@smthrs/*` packages that reach for Node builtins
	// through their platform shims. Nothing on the Worker path imports undici.
	"compatibility_flags": ["nodejs_compat"],
	// The QuickJS WebAssembly export has no .wasm suffix. Match it explicitly so
	// it is bundled as a compiled module, the only kind workerd instantiates.
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm", "@jitl/quickjs-wasmfile-release-sync/wasm"],
			"fallthrough": true
		}
	],
	// The custom domain declared in PACKAGE.ts. Point it at a zone your account
	// owns. Wrangler creates the DNS record and the certificate on first
	// deploy; removing this entry detaches the domain from this Worker.
	"routes": [{ "pattern": "__APP_NAME__.example.com", "custom_domain": true }],
	"assets": {
		// The SPA half of `vite build`. Relative to this file, so a bare
		// `wrangler deploy --config worker/wrangler.jsonc` finds it.
		//
		// @cloudflare/vite-plugin 1.53.0 does NOT read this value on the vite
		// path: `getOutputConfig` rewrites `assets.directory` in the generated
		// `dist/__APP_NAME__/wrangler.json` to the client output dir it
		// computed itself (dist/index.mjs, `getAssetsDirectory`), and
		// `.wrangler/deploy/config.json` redirects `wrangler deploy` to that
		// generated config. The value below is what a deploy that bypasses the
		// plugin uses, so both paths land on the same directory.
		"directory": "../dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Only the API is worker-first. Everything else is served from the
		// assets bucket without waking the Worker.
		"run_worker_first": ["/api/*"]
	},
	"durable_objects": {
		"bindings": [{ "name": "SESSIONS", "class_name": "AppSession" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppSession"] }],
	"vars": {
		"APP_NAME": "__APP_NAME__"
	},
	// Secrets, set with `wrangler secret put --config worker/wrangler.jsonc`.
	// Only the provider the app's AGENT.ts seats name has to be set, plus the
	// fork endpoint; a turn answers 503 until they are:
	//   OPENAI_API_KEY     — credential for an `openai:<model>` seat
	//   ANTHROPIC_API_KEY  — credential for an `anthropic:<model>` seat
	//   TEVM_FORK_RPC_URL  — JSON-RPC the Tevm fork reads chain state from
	//   APP_API_TOKEN      — shared credential every /api/* route but health
	//                        requires. Missing or empty refuses requests (401).
	//                        Set before deploy. APP_API_OPEN is local-only and
	//                        must not be added here. See worker/README.md.
	"observability": { "enabled": true }
}
