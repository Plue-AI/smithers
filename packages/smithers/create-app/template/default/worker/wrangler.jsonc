{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__APP_NAME__",
  "main": "./index.ts",
  "compatibility_date": "2026-08-01",
  // The agent path imports `@smthrs/*` packages that reach for Node builtins
  // through their platform shims.
  "compatibility_flags": ["nodejs_compat"],
  // The QuickJS WebAssembly export has no .wasm suffix. Match it explicitly so
  // it is bundled as a compiled module, the only kind workerd instantiates.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm", "@jitl/quickjs-wasmfile-release-sync/wasm"],
      "fallthrough": true
    }
  ],
  // The custom domain declared in PACKAGE.ts. Wrangler creates the DNS record
  // and the certificate on first deploy; removing this entry detaches the
  // domain from this Worker.
  "routes": [{ "pattern": "__APP_NAME__.example.com", "custom_domain": true }],
  "assets": {
    // The SPA half of `vite build`, relative to this file, so a bare
    // `wrangler deploy --config worker/wrangler.jsonc` finds it.
    "directory": "../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API is worker-first. Everything else is served from the assets
    // bucket without waking the Worker.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_NAME": "__APP_NAME__"
  },
  // Secrets, set with `wrangler secret put --config worker/wrangler.jsonc`.
  // Only the provider named by the seat in AGENT.ts has to be set.
  // The same seat judges completions; `/api/turn` answers 503 until connected:
  //   ANTHROPIC_API_KEY  — credential for an `anthropic:<model>` seat
  //   OPENAI_API_KEY     — credential for an `openai:<model>` seat
  //   APP_API_TOKEN      — bearer token `/api/turn` requires; unset, every turn
  //                        answers 401. Never set APP_API_OPEN on a deploy.
  "observability": { "enabled": true }
}
