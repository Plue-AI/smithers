# flows engine state (artifact CAS under .flows/objects, fork lanes under
# .flows/forks) — derived and engine-owned. jj must not snapshot it: a restore
# to a pre-publication change would delete CAS blobs live cache rows reference.
.flows/

# `.smithers/` holds the workspace declaration (WORKSPACE.ts), the factory
# declaration beside it (FACTORY.ts), the two files `//:factoryProjection`
# projects from it (factory.json, home.json), the target index
# `//:targetIndex` generates (target-index.json), and the Cloud machine
# expression Smithers Cloud builds this repository's image from
# (environment.nix), all of which are source. Only run state written beside
# them is ignored.
/.smithers/*
!/.smithers/WORKSPACE.ts
!/.smithers/FACTORY.ts
!/.smithers/factory.json
!/.smithers/home.json
!/.smithers/target-index.json
!/.smithers/environment.nix
**/.smithers/*.db
**/.smithers/*.db-*
**/.smithers/runs/
**/.smithers/executions/
**/.smithers/cache/
# Project roots `packages/smithers/test/FlowCatalogRefresh.test.ts` builds and
# then imports out of. They sit inside the package so this process loads their
# registration file as its own module, and the test removes each one; a killed
# run must not leave the checkout dirty with one.
packages/smithers/test/fixtures/.catalog-refresh/

# Scratch trees test lanes leave behind; never source.
/tmp/
smithers.db
smithers.db-shm
smithers.db-wal

# Reference corpus — shallow clones read by agents, never committed.
reference/*
!reference/electrobun-shell/

# Launch-checklist dry runs prove the runner, not the product: they touch no
# origin, so they are never evidence and never belong in the tracked report
# trail under apps/reports/launch-checklist/.
apps/reports/launch-checklist/*-dry-run/

# Crush agent local session database
.crush/

# Commit-pass mutexes. Several sessions commit into this checkout at once and
# coordinate through these paths, so they exist while work is in flight. They
# are host state, not source: jj snapshots the working copy, so an unignored
# lock reaches the index.
.commit-lock
.commit-lock-pass/

# apps/app agent-lane evidence: reports, screenshots, handoffs and A/B
# harness configs, kept on disk, never committed
apps/app/*.png
apps/app/.fix2.*
apps/app/tutorial2-shots/
apps/app/handoffs/
apps/app/first-load-fix2-evidence/
apps/app/AUTO_ADVANCE.md
apps/app/BUTTONS.md
apps/app/FILL_HEIGHT.md
apps/app/FIRST_LOAD_*
apps/app/KEYS3.md
apps/app/NAV_KEYS*.md
apps/app/NOTIFY_*
apps/app/PALETTE_VERIFY.md
apps/app/PIN_NAV.md
apps/app/REORDER.md
apps/app/TUTORIAL2_INTEGRATION.md
apps/app/WHITESPACE*.md

# apps/app/e2e root-level *.mjs are throwaway screenshot/probe scripts (hardcoded ports, temp paths)
apps/app/e2e/*.mjs

# Review reports and ledgers stay on disk (Will 2026-09-04: review evidence is never committed)
docs/reviews/

# disposable one-off probe scripts (apps/app/.impl13.tmp.mjs style)
.*.tmp.mjs

# pnpm self-links: `pnpm install` links each workspace package into
# node_modules/.pnpm/node_modules/<name>, and that link points back at the
# package directory. When the package's own folder then gains a link of the
# same name, the path resolves to its own parent: an infinite self-reference
# that jj snapshots as a tracked file. Exact paths only; the package name is
# still legitimately used by `pnpm --filter <name>`.
/apps/app/smithers-app
/apps/ui/smithers-ui
/apps/server/smithers-server
/apps/tutorial-coordinator/smithers-tutorial-coordinator
/packages/smthrs-deprecation/smthrs

# Throwaway discovery and repro scripts; they say "not shipped" in their headers.
apps/app/scripts/tmp-*
zz-*-repro.*

# Run scratch: captured shell exit codes and enrollment-sweep traces.
# scripts/repo-contract/scratch-artifacts.test.mjs fails if one is tracked.
.enrollment-*
*.exit
/apps/backend/backend
__pycache__/
