    {
      "name": "admin posts",
      "action": "created",
      "author": {
        "login": "alice",
        "type": "User"
      },
      "sender": {
        "login": "alice",
        "type": "User"
      },
      "permissions": {
        "alice": "admin"
      },
      "expect": "maintainer"
    },
    {
      "name": "write (or maintain) user posts",
      "action": "created",
      "author": {
        "login": "wes",
        "type": "User"
      },
      "sender": {
        "login": "wes",
        "type": "User"
      },
      "permissions": {
        "wes": "write"
      },
      "expect": "maintainer"
    },
    {
      "name": "triage user posts",
      "action": "created",
