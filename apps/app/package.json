{
  "name": "smithers-app",
  "private": true,
  "version": "1.0.0",
  "description": "Smithers browser app",
  "scripts": {
    "start": "bun src/bun/serve.ts",
    "dev": "vite --configLoader runner",
    "build:web": "vite build --configLoader runner",
    "build": "pnpm run build:web",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "bun test src e2e/contracts e2e/real/coverage e2e/real/support e2e/real/auth-permissions/profile.test.ts scripts",
    "lint:conformance": "bun test lint/conformance",
    "checklist": "bun scripts/launch-checklist.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "bun scripts/run-real-e2e.ts",
    "test:e2e:matrix": "bun scripts/run-mode-matrix.ts run",
    "showcase": "bun scripts/showcase.ts",
    "test:e2e:site": "playwright test --config playwright.site.config.ts",
    "test:e2e:auth": "bun test e2e/native/CloudAuthFragment.test.ts",
    "test:e2e:probes": "bun test e2e/probes",
    "test:e2e:graph-lifecycle": "bun test e2e/graph/lifecycle",
    "proof:gateway": "tsx scripts/gateway-run-proof.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@journeyapps/wa-sqlite": "1.7.2",
    "@smthrs/canonical": "workspace:*",
    "@smthrs/capability": "workspace:*",
    "@smthrs/chain": "workspace:*",
    "@smthrs/core": "workspace:*",
    "@smthrs/crypto": "workspace:*",
    "@smthrs/database": "workspace:*",
    "@smthrs/engine-store": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/gateway": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/harness-detect": "workspace:*",
    "@smthrs/jj": "workspace:*",
    "@smthrs/journal": "workspace:*",
    "@smthrs/kernel": "workspace:*",
    "@smthrs/memory": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/model-host": "workspace:*",
    "@smthrs/patterns": "workspace:*",
    "@smthrs/platform-browser": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/rpc": "workspace:*",
    "@smthrs/ui": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@tanstack/browser-db-sqlite-persistence": "0.2.20",
    "@tanstack/db": "0.8.7",
    "@tanstack/react-db": "0.3.7",
    "@xyflow/react": "^12.11.6",
    "dagre": "^0.8.5",
    "effect": "4.0.0-rc.115",
    "lucide-react": "1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yjs": "13.6.32",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@happy-dom/global-registrator": "^20.13.2",
    "@playwright/test": "1.62.1",
    "@smthrs/control": "workspace:*",
    "@smthrs/notifications": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/run-store": "workspace:*",
    "@smthrs/sync": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "latest",
    "@types/d3-force": "3.0.10",
    "@types/dagre": "0.7.54",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.13.0",
    "happy-dom": "20.13.2",
    "playwright": "1.62.1",
    "postcss": "^8.5.28",
    "smithers-server": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vite": "8.2.2"
  }
