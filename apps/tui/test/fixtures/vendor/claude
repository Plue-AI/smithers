#!/bin/sh
# A stand-in for Claude Code: logs its argv, then streams stream-json when headless (-p)
# or acts as its interactive TUI on the resumed session until a line is typed.
# One line per launch: the brief's own newlines become spaces.
prompt=""
case " $* " in *" -p "*) prompt="$(cat)" ;; esac
printf '%s\n' "$(printf '%s <<< %s' "$*" "$prompt" | tr '\n' ' ')" >> "${FAKE_VENDOR_LOG:-/dev/null}"
session=""
headless=""
prev=""
for arg in "$@"; do
  case "$prev" in
    --session-id|--resume) session="$arg" ;;
  esac
  [ "$arg" = "-p" ] && headless=1
  prev="$arg"
done
if [ -z "$headless" ]; then
  printf 'claude session %s\n> ' "$session"
  read -r line
  exit 0
fi
pause="${FAKE_VENDOR_PAUSE:-0}"
printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$session"
sleep "$pause"
printf '{"type":"assistant","message":{"id":"m1","content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"src/session.ts"}}],"usage":{"input_tokens":10,"cache_read_input_tokens":90,"output_tokens":5}}}\n'
printf '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":"line one\\nline two\\nline three"}]}}\n'
sleep "$pause"
printf '{"type":"assistant","message":{"id":"m2","content":[{"type":"text","text":"Refreshed the cookie before retry."}],"usage":{"input_tokens":10,"cache_read_input_tokens":90,"output_tokens":5}}}\n'
# The vendor repeats a call's usage on each of its content blocks.
printf '{"type":"assistant","message":{"id":"m2","content":[],"usage":{"input_tokens":10,"cache_read_input_tokens":90,"output_tokens":5}}}\n'
printf '{"type":"result","subtype":"success","is_error":false,"result":"Refreshed the cookie before retry.","session_id":"%s"}\n' "$session"
