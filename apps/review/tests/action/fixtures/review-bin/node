#!/bin/sh
# Test fixture: a fake `node` on PATH for apps/review/tests/action/runAction.test.ts.
#
# Checked in and executable (not written at test time) so spawning it never
# races a fresh write-then-exec.
#
# Stands in for the review CLI: writes $SMITHERS_FAKE_REVIEW_SUMMARY to
# $SMITHERS_REVIEW_SUMMARY_PATH, then exits with $SMITHERS_FAKE_REVIEW_EXIT
# (default 0). With $SMITHERS_FAKE_REVIEW_ENV_LOG set, it also records the
# inference variables it was spawned with, one NAME=value per line.
if [ -n "$SMITHERS_FAKE_REVIEW_ENV_LOG" ]; then
  {
    printf 'ANTHROPIC_API_KEY=%s\n' "$ANTHROPIC_API_KEY"
    printf 'ANTHROPIC_BASE_URL=%s\n' "$ANTHROPIC_BASE_URL"
    printf 'OPENAI_API_KEY=%s\n' "$OPENAI_API_KEY"
    printf 'OPENROUTER_API_KEY=%s\n' "$OPENROUTER_API_KEY"
    printf 'SMITHERS_REVIEW_SEAT=%s\n' "$SMITHERS_REVIEW_SEAT"
    printf 'SMITHERS_REVIEW_CHEAP_SEAT=%s\n' "$SMITHERS_REVIEW_CHEAP_SEAT"
    printf 'SMITHERS_REVIEW_VERIFY_SEAT=%s\n' "$SMITHERS_REVIEW_VERIFY_SEAT"
    printf 'SMITHERS_REVIEW_NARRATE_SEAT=%s\n' "$SMITHERS_REVIEW_NARRATE_SEAT"
    printf 'SMITHERS_REVIEW_QUIZ_SEAT=%s\n' "$SMITHERS_REVIEW_QUIZ_SEAT"
  } > "$SMITHERS_FAKE_REVIEW_ENV_LOG"
fi
printf '%s' "$SMITHERS_FAKE_REVIEW_SUMMARY" > "$SMITHERS_REVIEW_SUMMARY_PATH"
exit "${SMITHERS_FAKE_REVIEW_EXIT:-0}"
