{
  "name": "@smthrs/review",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "Code review plus story-form HTML walkthrough, as a Smithers flow",
  "license": "MIT",
  "type": "module",
  "smthrs": {
    "group": "agent"
  },
  "bin": {
    "smithers-review": "./bin/smithers-review.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cli": "./src/cli/main.ts",
    "./diffs": "./src/diffs/index.ts",
    "./workflow": "./src/workflow/reviewFlow.ts",
    "./workflow/layer": "./src/workflow/reviewLayer.ts"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "node ./bin/smithers-review.mjs",
    "test": "bun test tests",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "plan": "alchemy deploy --dry-run --stage prod",
    "deploy": "node ../../flows/rollout/refuse-unqualified.mjs",
    "destroy": "alchemy destroy --stage prod",
    "test:live": "SMITHERS_REVIEW_E2E=1 bun test tests/reviewPullRequest.e2e.test.ts tests/action/liveWorkflow.e2e.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@pierre/diffs": "^1.3.6",
    "@smthrs/agent": "workspace:*",
    "@smthrs/capability": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/flows": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/kernel": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/ui-styleguide": "workspace:*",
    "effect": "4.0.0-rc.115",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "alchemy": "2.0.0-beta.76",
    "bun-types": "^1.4.0",
    "happy-dom": "^20.13.2",
    "typescript": "~5.9.3",
    "yaml": "^2.9.0"
  }
}
