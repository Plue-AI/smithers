{
  "name": "@smthrs/bug-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Worker behind bug.smithers.sh that receives smithers bug reports and stores them in KV",
  "type": "module",
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "plan": "alchemy deploy --dry-run --stage prod",
    "deploy": "node ../../flows/rollout/refuse-unqualified.mjs",
    "destroy": "alchemy destroy --stage prod"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@smthrs/control": "workspace:*",
    "@types/node": "26.4.1",
    "alchemy": "2.0.0-beta.76",
    "bun-types": "^1.4.0",
    "effect": "4.0.0-rc.115",
    "typescript": "~5.9.3"
  }
}
