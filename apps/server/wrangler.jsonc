{
	// THE DEPLOY CONFIGURATION: the shared edge. `scripts/deploy.ts` builds the site
	// and runs `wrangler deploy` over this file; src/workerIdentity.test.ts holds every
	// identity field here to src/workerIdentity.ts. The edge serves the site and
	// forwards /api unchanged to the shared backend (DEPLOY.md).
	// Secrets are not in this file; every deploy keeps them (DEPLOY.md "Secrets").
	"name": "smithers-mvp-web",
	"main": "src/edge.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Logs: without this the live script records nothing, so an outage
	// leaves no request or exception log to read afterwards.
	"observability": { "enabled": true },
	// Wave 7: this Worker IS the canary. The custom domain was repointed from
	// the POC worker `smithers-ui-canary`, which cannot take it back: the
	// repository it deploys from dropped this route from its own config and
	// retired its deploy job, so a deploy there publishes routeless. The
	// rollback is this Worker's own — `bun apps/server/scripts/deploy.ts` from a
	// Smithers checkout at the wanted sha, or `bun x wrangler rollback
	// <version-id>` from apps/server for a version already on the account
	// (`bun x wrangler deployments list` names them; DEPLOY.md "Rollback").
	// The app under the apex (wave "smithers.sh is the product"): this Worker
	// serves the whole smithers.sh Astro build (landing, docs, the prerendered
	// app page, /_astro chunks), so one zone route claims every apex path, and
	// no other Worker may claim the apex (apps/site/scripts/deployment.test.mjs).
	// Splitting the apex
	// by prefix served page HTML from one build and its /_astro chunks from the
	// other (404). Rollback: restore the three narrow routes (smithers.sh/smithersai/*,
	// /api/*, /assets/*) and deploy; the canary custom domain is untouched either way.
	"routes": [
		{ "pattern": "canary.smithers.sh", "custom_domain": true },
		{ "pattern": "smithers.sh/*", "zone_id": "8ebd98d2f0dc7d8db2e61f31ebc19c14" },
		{ "pattern": "www.smithers.sh/*", "zone_id": "8ebd98d2f0dc7d8db2e61f31ebc19c14" }
	],
	// The assets are the smithers.sh Astro build in the sibling `apps/site`
	// package: the landing page, the docs, and the product app prerendered at
	// /<owner>/<name>/index.html as a React island. `pnpm run build` there must
	// run before `wrangler dev` or `wrangler deploy` here (scripts/deploy.ts
	// does), because an unbuilt `../site/dist` is an empty site. This directory
	// is the second deliberate identity change on record (DEPLOY.md); the
	// previous value was `../ui/dist` with `single-page-application` handling.
	"assets": {
		"directory": "../site/dist",
		"binding": "ASSETS",
		// The build carries a 404 page, and the app document is the Worker's to
		// serve (src/edge.ts), so no path falls back to a SPA shell.
		"not_found_handling": "404-page",
		// Every request reaches the Worker: repository slugs and their casing
		// cannot be enumerated by owner, and HTML headers / HTTPS / www redirects
		// must run even when assets_navigation_prefers_asset_serving is enabled.
		// The Worker delegates site pages, legacy redirects, and chunks to ASSETS.
		"run_worker_first": ["/*"]
	},
	// Retained namespace identities only: inert classes keep the storage for
	// rollback (docs/shared-edge-cutover.md). No deletion migration.
	"durable_objects": {
		"bindings": [
			{ "name": "TURN_CANCELS", "class_name": "TurnCancelRegistry" },
			{ "name": "GATEWAY_SESSIONS", "class_name": "GatewaySessionRegistry" },
			{ "name": "TURN_LIMITS", "class_name": "TurnRateLimiter" },
			{ "name": "CLIENT_ERRORS", "class_name": "ClientErrorLog" },
			{ "name": "RECOMMEND_LOG", "class_name": "RecommendLog" },
			{ "name": "MODEL_VAULTS", "class_name": "AccountModelVault" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TurnCancelRegistry"] },
		{ "tag": "v2", "new_sqlite_classes": ["GatewaySessionRegistry"] },
		{ "tag": "v3", "new_sqlite_classes": ["TurnRateLimiter", "ClientErrorLog"] },
		{ "tag": "v4", "new_sqlite_classes": ["RecommendLog"] },
		{ "tag": "v5", "new_sqlite_classes": ["AccountModelVault"] }
	],
	// Secrets remain bound for rollback; this edge reads none of the retired
	// product credentials.
	"vars": {
		"SMITHERS_BACKEND_ORIGIN": "https://api.jjhub.tech"
		// Cloudflare secrets remain bound for migration/rollback, never active edge use:
		//   MODEL_VAULT_KEY — decrypts the legacy export only inside the old authority.
	}
}
