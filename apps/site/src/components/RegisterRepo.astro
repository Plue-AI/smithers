---
import { APPLICATION_SIGN_IN_PATH } from "../../../../packages/rpc/src/ApplicationAuth"
/* Registration is two steps: sign in with GitHub, then install the Smithers
   GitHub App on the repository. Installing the app is what registers the repo. */
const signInUrl = `${APPLICATION_SIGN_IN_PATH}?return_to=${encodeURIComponent(Astro.url.pathname)}`
const installUrl = "https://github.com/apps/smitherspreviewrelease/installations/new"
---

<section class="register wrap" aria-labelledby="register-title">
  <div class="register-card">
    <div class="intro">
      <h2 id="register-title">Register your repo</h2>
      <p>Smithers is in private alpha and only available to a select number of open source repos.</p>
    </div>
    <div class="steps">
      <ol>
        <li><strong>Sign in with GitHub.</strong> On the web your GitHub sign-in is your Smithers account.</li>
        <li><strong>Add the Smithers application to your repo.</strong> Installing the GitHub App on a repository registers it with Smithers.</li>
      </ol>
      <div class="actions">
        <a class="btn primary" href={signInUrl}>Sign in with GitHub</a>
        <a class="btn ghost" href={installUrl}>Add Smithers to your repo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .register { max-width: 1040px; margin-top: 1.6rem; margin-bottom: 4rem; }
  .register-card { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--border-strong); border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-2); }
  h2 { margin: 0 0 1rem; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.1; letter-spacing: -.035em; }
  .intro p { color: var(--text-muted); line-height: 1.65; margin: 0; }
  .steps { align-self: center; }
  ol { margin: 0 0 1.75rem; padding-left: 1.2rem; color: var(--text-muted); line-height: 1.6; }
  li + li { margin-top: .6rem; }
  ol strong { color: var(--text); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  @media (max-width: 720px) { .register-card { grid-template-columns: 1fr; gap: 2rem; } }
</style>
