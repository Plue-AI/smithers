---
import { Font } from "astro:assets"
import { applicationTarget } from "../lib/applicationTarget"
import "../styles/site.css"
import "../styles/navigation.css"
interface Props {
  title: string
  description: string
  header?: boolean
  footer?: boolean
}
const { title, description, header = true, footer = true } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="smithers-application-target" content={JSON.stringify(applicationTarget)} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/media/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/media/og.png", Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Self-hosted, inlined @font-face rules. Only the regular latin face of
        each family is preloaded: those are the ones the landing page paints
        first, and preloading the rest would compete with them. */}
    <Font cssVariable="--font-inter" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
  </head>
  <body>
    {header && (
      <header class="wrap top">
        <a class="mark" href="/" data-astro-prefetch="hover"><img src="/icon.png" alt="" width="26" height="26" /> Smithers</a>
        <nav class="nav">
          <a href="/docs/" data-astro-prefetch="hover">Documentation</a>
          <a href="/pricing/" data-astro-prefetch="hover">Pricing</a>
          <a href="https://github.com/smithersai/smithers">GitHub</a>
        </nav>
      </header>
    )}
    <slot />
    {footer && (
      <footer class="wrap foot">
        <span>© {new Date().getFullYear()} Smithers</span>
        <a href="/docs/" data-astro-prefetch="hover">Documentation</a>
        <a href="/pricing/" data-astro-prefetch="hover">Pricing</a>
        <a href="https://github.com/smithersai/smithers">Source, MIT</a>
        <a href="https://status.smithers.sh">Status</a>
        <a href="/terms/">Terms</a>
        <a href="/privacy/">Privacy</a>
        <a href="/refunds/">Refunds</a>
      </footer>
    )}
  </body>
</html>
