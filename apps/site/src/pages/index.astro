---
import Base from "../layouts/Base.astro"
import project from "../data/project.json"
import { DEFAULT_APP_DOCUMENT_PATH } from "../../../server/src/appDocument"
// The app's entrance mark (apps/app/src/mainview/SessionShell.tsx), reused verbatim.
import { WORDMARK } from "../../../app/src/mainview/Wordmark"

const title = "Smithers"
const description = project.tagline
/*
 * Get started for free opens the app in this document: the script below mounts
 * apps/app (AppMount.tsx) directly and the wordmark becomes the
 * app's own. The href resumes the same signup for a middle-click or a new
 * tab. The prerendered app document supplies assets independently of any
 * repository's availability. GitHub is a plain secondary link beside
 * Get started for free.
 */
const appHref = "/?tutorial"
const githubHref = "https://github.com/smithersai/smithers"
---

<Base title={title} description={description} header={false} footer="legal">
  <main class="wrap hero home">
    <h1 class="wordmark" aria-label="Smithers">
      <pre aria-hidden="true">{WORDMARK.map((line, row) => <span class="wordmark-row" style={`--row: ${row}`}>{line}</span>)}</pre>
    </h1>
    <p class="sub">{project.tagline}</p>
    <div class="actions">
      {/* JS hides the button (html.js) until the app is loaded; without JS it shows at once. */}
      <script is:inline>document.documentElement.classList.add("js")</script>
      <a id="start" class="start" href={appHref} data-app-document={DEFAULT_APP_DOCUMENT_PATH} aria-keyshortcuts="s">
        <span>Get started for free</span>
      </a>
      <a class="btn ghost" href={githubHref} target="_blank" rel="noopener noreferrer">GitHub</a>
      <div id="start-error" hidden>
        <p role="alert">Smithers couldn't load. Reload to try again.</p>
        <button id="start-reload" class="start ready" type="button">Reload</button>
      </div>
    </div>
  </main>
</Base>

<script>
  import { bindPressActions } from "../../../app/src/mainview/runtime/PressActions"
  import { writerTakeoverRequested } from "../../../app/src/mainview/state/WriterOwnership"
  import { shouldResumeApp } from "../lib/appHistory"
  import { sameOriginUrl } from "../lib/sameOriginUrl"
  /*
   * The app arrives in this document. After `load` and an idle moment the
   * page reads the prerendered app document for the app's
   * island chunk and stylesheets, imports the chunk, and Get started for free appears.
   * AppMount stays out of this page's module graph: Astro would link
   * every stylesheet the graph reaches into this page's head, render-blocking.
   * Get started for free, or S, mounts the app directly inside a view
   * transition: the hero wordmark glides onto the app's top-left mark, the
   * page fades away, and Suspense paints the shell while boot fills in the
   * app. The URL stays where it is.
   */
  type AppMount = Pick<typeof import("../../../app/src/mainview/AppMount"), "mountApp"> & Partial<Pick<typeof import("../../../app/src/mainview/AppMount"), "warmApp">>
  type Sheet = HTMLLinkElement | HTMLStyleElement

  const start = document.getElementById("start") as HTMLAnchorElement | null
  const failure = document.getElementById("start-error")!
  const reload = document.getElementById("start-reload")!
  reload.addEventListener("click", () => window.location.reload())
  const reduced = matchMedia("(prefers-reduced-motion: reduce)")
  const TRANSITION_STYLE_ID = "smithers-enter-app"
  const MARK_NAME = "smithers-wordmark"
  const TAGLINE_NAME = "smithers-tagline"
  /* The signup hero's headline (apps/app/src/mainview/cards/SignupCards.tsx) is the tagline's landing spot. */
  const HEADLINE = ".signup-hero h1"
  const HEADLINE_WAIT_MS = 600
  const APP_MARK_SELECTOR = ".session-shell > .session-navigation > .guide-wordmark"
  /* The mark in SessionNavigation's header (apps/app/src/mainview/SessionNavigation.tsx; guide.css .guide-wordmark). */
  const APP_MARK = { left: 12, top: 12, fontSize: 2.75 }
  const TRANSITION_CSS = `
    @media (prefers-reduced-motion: no-preference) {
      ::view-transition-group(${MARK_NAME}) { animation-duration: 210ms; animation-timing-function: cubic-bezier(0.2, 0, 0, 1); }
      ::view-transition-old(${MARK_NAME}) { animation: smithers-mark-out 210ms linear both; }
      ::view-transition-group(${TAGLINE_NAME}) { animation-duration: 420ms; animation-timing-function: cubic-bezier(0.2, 0, 0, 1); }
      ::view-transition-old(${TAGLINE_NAME}), ::view-transition-new(${TAGLINE_NAME}) { height: 100%; object-fit: contain; }
      ::view-transition-new(${MARK_NAME}) { animation: smithers-mark-in 210ms linear both; }
      ::view-transition-old(root) { animation: smithers-home-out 100ms cubic-bezier(0.4, 0, 1, 1) both; }
      ::view-transition-new(root) { animation: smithers-app-in 180ms cubic-bezier(0.22, 0.61, 0.21, 1) both; }
    }
    @keyframes smithers-mark-out { 0%, 80% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes smithers-mark-in { 0%, 80% { opacity: 0; } 100% { opacity: 1; } }
    @keyframes smithers-home-out { to { opacity: 0; transform: translateY(-6px); } }
    @keyframes smithers-app-in { from { opacity: 0; transform: translateY(6px); } }
  `

  if (start) {
    const appDocument = new URL(start.dataset.appDocument!, location.href).href
    /*
     * The app's stylesheets restyle html and body (its base.css), so each one
     * the import adds stays inert (media="not all") until the app mounts, and
     * the home page's own sheets go inert then. A MutationObserver callback
     * runs before the next frame, so no frame paints with both.
     */
    const homeSheets: Array<Sheet> = Array.from(document.querySelectorAll<Sheet>('link[rel="stylesheet"], style'))
    const appSheets: Array<Sheet> = []
    const hold = new MutationObserver((records) => {
      for (const record of records) {
        for (const node of record.addedNodes) {
          const sheet = node instanceof HTMLLinkElement && node.rel === "stylesheet" ? node : node instanceof HTMLStyleElement ? node : null
          if (sheet === null || sheet.id === TRANSITION_STYLE_ID) continue
          sheet.media = "not all"
          appSheets.push(sheet)
        }
      }
    })

    /* The app page names its island chunk (AppIsland, whose default export carries mountApp) and its stylesheets. */
    const importApp = async (): Promise<AppMount> => {
      const response = await fetch(appDocument, { priority: "low", credentials: "same-origin" } as RequestInit)
      if (!response.ok) throw new Error(`The app page answered HTTP ${response.status}.`)
      // Every chunk and stylesheet the page names must stay on this origin, including after a redirect.
      const pageUrl = sameOriginUrl(response.url || appDocument, appDocument, location.origin)
      const page = new DOMParser().parseFromString(await response.text(), "text/html")
      const chunk = page.querySelector("astro-island[component-url]")?.getAttribute("component-url")
      if (!chunk) throw new Error("The app page names no island chunk.")
      const loaded = Array.from(page.querySelectorAll<Sheet>('link[rel="stylesheet"][href], style'), (source) => {
        const sheet = source instanceof HTMLLinkElement ? document.createElement("link") : document.createElement("style")
        if (sheet instanceof HTMLLinkElement) {
          sheet.rel = "stylesheet"
          sheet.href = sameOriginUrl(source.getAttribute("href") ?? "", pageUrl, location.origin)
        } else sheet.textContent = source.textContent
        document.head.append(sheet)
        return sheet instanceof HTMLLinkElement
          ? new Promise<void>((resolve) => { sheet.addEventListener("load", () => resolve(), { once: true }); sheet.addEventListener("error", () => resolve(), { once: true }) })
          : Promise.resolve()
      })
      // Astro's own hydration order: the before-hydration script (the React refresh preamble in dev) runs first.
      const before = page.querySelector("astro-island[before-hydration-url]")?.getAttribute("before-hydration-url")
      if (before) await import(/* @vite-ignore */ sameOriginUrl(before, pageUrl, location.origin))
      const island = (await import(/* @vite-ignore */ sameOriginUrl(chunk, pageUrl, location.origin))) as { default?: Partial<AppMount> }
      await Promise.all(loaded)
      const mountApp = island.default?.mountApp
      const warmApp = island.default?.warmApp
      if (typeof mountApp !== "function") throw new Error("The app chunk carries no mountApp.")
      if (typeof warmApp === "function") void warmApp().catch(() => {})
      return { mountApp }
    }
    let app: Promise<AppMount> | undefined
    const load = (): Promise<AppMount> => {
      if (app !== undefined) return app
      hold.observe(document.head, { childList: true })
      app = importApp()
      app.catch(() => {
        app = undefined
      })
      return app
    }

    let shown = false
    const show = (): void => {
      if (shown) return
      shown = true
      start.classList.add("ready")
    }
    const fallback = setTimeout(show, 4000)
    const preload = (): void => {
      load()
        .catch(() => {})
        .finally(() => {
          clearTimeout(fallback)
          show()
        })
    }
    const idle = (): void => {
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
      if (connection?.saveData === true) return show()
      if ("requestIdleCallback" in window) requestIdleCallback(preload, { timeout: 2000 })
      else setTimeout(preload, 200)
    }

    /** Swap the home page for the app; answers the app's entrance mark. */
    const swap = (mount: AppMount): HTMLElement | null => {
      stopPress()
      hold.disconnect()
      for (const sheet of homeSheets) sheet.media = "not all"
      for (const sheet of appSheets) sheet.removeAttribute("media")
      document.querySelector("main.home")?.remove()
      const root = document.createElement("div")
      root.id = "root"
      document.body.append(root)
      return mount.mountApp(root, { keepUrl: true }).mark
    }

    const waitFor = async (selector: string, ms: number): Promise<HTMLElement | null> => {
      const deadline = performance.now() + ms
      for (;;) {
        const found = document.querySelector<HTMLElement>(selector)
        if (found !== null || performance.now() >= deadline) return found
        await new Promise((resolve) => setTimeout(resolve, 16))
      }
    }

    /* Without same-document view transitions: fly the mark by hand, then swap. */
    const flight = async (): Promise<void> => {
      const pre = document.querySelector<HTMLElement>(".wordmark pre")
      if (pre === null) return
      const rect = pre.getBoundingClientRect()
      const scale = APP_MARK.fontSize / parseFloat(getComputedStyle(pre).fontSize)
      const easing = "cubic-bezier(0.2, 0, 0, 1)"
      for (const el of document.querySelectorAll<HTMLElement>(".home .sub, .home .actions")) {
        el.animate([{ opacity: 1 }, { opacity: 0, transform: "translateY(-6px)" }], { duration: 100, easing, fill: "forwards" })
      }
      await pre.animate(
        [
          { transformOrigin: "0 0", transform: "none" },
          { transformOrigin: "0 0", transform: `translate(${APP_MARK.left - rect.left}px, ${APP_MARK.top - rect.top}px) scale(${scale})` }
        ],
        { duration: 210, easing, fill: "forwards" }
      ).finished
    }

    let entering = false
    const enter = async (instant = false): Promise<void> => {
      if (entering) return
      entering = true
      // Finish the entrance before the complete mark flies into the app header.
      document.querySelector(".wordmark")?.classList.add("settled")
      start.classList.add("pending")
      start.setAttribute("aria-busy", "true")
      let mount: AppMount
      try {
        mount = await load()
      } catch {
        // Failed imports can remain cached for this document. Offer a fresh
        // document instead of returning to an apparently idle Get started for free.
        stopPress()
        start.classList.remove("pending")
        start.removeAttribute("aria-busy")
        start.hidden = true
        failure.hidden = false
        document.documentElement.classList.remove("entering")
        if (!instant) reload.focus({ preventScroll: true })
        return
      }
      // Mount first: Suspense paints the shell while boot runs alongside the
      // transition. The app owns boot failures through its boundary and watchdog.
      if (instant || reduced.matches || typeof document.startViewTransition !== "function") {
        if (!instant && !reduced.matches) await flight()
        swap(mount)
        return
      }
      const style = document.createElement("style")
      style.id = TRANSITION_STYLE_ID
      style.textContent = TRANSITION_CSS
      document.head.append(style)
      let mark: HTMLElement | null = null
      let headline: HTMLElement | null = null
      document.querySelector<HTMLElement>(".home .sub")?.style.setProperty("view-transition-name", TAGLINE_NAME)
      const transition = document.startViewTransition(async () => {
        mark = swap(mount)
        mark?.style.setProperty("view-transition-name", MARK_NAME)
        // The tagline glides into the signup headline once the app paints it; without one in time, it fades with the page.
        headline = await waitFor(HEADLINE, HEADLINE_WAIT_MS)
        // The shell that replaced the Suspense fallback carries its own mark (AppMount appWordmark's selector).
        const settledMark = document.querySelector<HTMLElement>(APP_MARK_SELECTOR)
        if (settledMark !== null && settledMark !== mark) {
          mark?.style.removeProperty("view-transition-name")
          mark = settledMark
          mark.style.setProperty("view-transition-name", MARK_NAME)
        }
        if (headline === null) return
        headline.dataset.arrived = ""
        headline.style.setProperty("view-transition-name", TAGLINE_NAME)
      })
      await transition.finished.catch(() => {})
      ;(mark as HTMLElement | null)?.style.removeProperty("view-transition-name")
      ;(headline as HTMLElement | null)?.style.removeProperty("view-transition-name")
      style.remove()
    }

    start.addEventListener("click", (event) => {
      // A modified or middle click keeps the link's meaning: the app page, in a new tab.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      event.preventDefault()
      void enter()
    })
    const stopPress = bindPressActions({
      root: start,
      enabled: () => !entering,
      resolveShortcut: (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey || event.key.toLowerCase() !== "s") return
        return { element: start, activate: () => { start.focus({ preventScroll: true }); void enter() } }
      },
    })

    /*
     * GitHub sign-in returns to this page with
     * `?signed-in` or `?auth=failed|error`: the app resumes at once, where
     * it was, and reads the marker itself.
     */
    if (shouldResumeApp(location.search, writerTakeoverRequested())) {
      document.documentElement.classList.add("entering")
      void enter(true)
    } else if (document.readyState === "complete") idle()
    else addEventListener("load", idle, { once: true })
  }
</script>

<style>
  /*
   * The app's accent (apps/app/src/mainview/styles/base.css .session-shell
   * --g-accent) colors the wordmark and fills Get started for free.
   */
  :global(:root) {
    --home-accent: #3a756b;
    --home-accent-hover: #2f6158;
    --home-accent-ink: #ffffff;
    --home-key-bg: #f7f6f1;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --home-accent: #9bd5c6;
      --home-accent-hover: #b4e2d6;
      --home-accent-ink: #011627;
      --home-key-bg: #14312b;
    }
  }

  /* 63 monospace columns at 0.6em each span ~38em; the size follows the viewport. */
  .wordmark {
    display: flex;
    justify-content: center;
    color: var(--home-accent);
    margin: 0 0 1.6rem;
  }
  .wordmark pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(4px, 2.2vw, 16px);
    line-height: 1.07;
    letter-spacing: 0;
    font-weight: 400;
    white-space: pre;
    /* Shared with the app's mark while Get started for free's view transition runs. */
    view-transition-name: smithers-wordmark;
  }

  .wordmark-row { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .wordmark-row {
      --scan-edge: 0 8% 0 0;
      --scan-offset: -0.12em;
      color: transparent;
      background-image: linear-gradient(105deg,
        var(--home-accent) 42%,
        color-mix(in srgb, var(--home-accent), white 12%) 49%,
        var(--home-accent) 56%);
      background-size: 300% 100%;
      background-position: 0 0;
      background-clip: text;
      -webkit-background-clip: text;
      animation:
        wordmark-scan 420ms cubic-bezier(0.16, 1, 0.3, 1) calc(40ms + var(--row) * 20ms) backwards,
        wordmark-sweep 480ms cubic-bezier(0.4, 0, 0.2, 1) 360ms backwards;
    }
    .wordmark-row:nth-child(even) {
      --scan-edge: 0 0 0 8%;
      --scan-offset: 0.12em;
    }
    .wordmark.settled .wordmark-row { animation: none; }
    /* Decorative rows ripple independently; the pre stays free for app-entry flight. */
    .wordmark .wordmark-row {
      transition: transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1.15), opacity 380ms var(--ease);
      transition-delay: calc(var(--row) * 22ms);
    }
    .home .sub {
      transition: transform 280ms var(--ease), opacity 280ms var(--ease);
    }
    @media (hover: hover) {
      .wordmark pre:hover .wordmark-row {
        transform: translateY(calc((var(--row) - 2) * -2px)) scale(1.012);
        opacity: 0.88;
      }
      .home .sub:hover { transform: translateY(-3px); opacity: 0.8; }
    }
    .wordmark pre:active .wordmark-row {
      transform: translateY(2px) scale(0.99);
      opacity: 0.7;
      transition-duration: 100ms;
      transition-delay: 0ms;
    }
    .home .sub:active { transform: translateY(1px) scale(0.995); opacity: 0.7; }
  }
  @keyframes wordmark-scan {
    from { clip-path: inset(var(--scan-edge)); transform: translateX(var(--scan-offset)); }
    to { clip-path: inset(0); transform: none; }
  }
  @keyframes wordmark-sweep {
    from { background-position: 100% 0; }
    to { background-position: 0 0; }
  }

  .start {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    min-width: 220px;
    min-height: 56px;
    padding: 0.95rem 2.1rem;
    border-radius: 999px;
    background: var(--home-accent);
    color: var(--home-accent-ink);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 16%), 0 3px 0 color-mix(in srgb, var(--home-accent) 78%, #011627), 0 7px 18px rgb(var(--shadow-rgb) / 16%);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 160ms var(--ease), transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 180ms var(--ease);
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }
  .start[hidden] { display: none; }
  #start-error p { margin: 0 0 1rem; }
  @media (hover: hover) {
    .start:hover {
      background: var(--home-accent-hover);
      transform: translateY(-2px);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%), 0 4px 0 color-mix(in srgb, var(--home-accent) 78%, #011627), 0 11px 24px rgb(var(--shadow-rgb) / 20%);
    }
  }
  .start:active,
  .start[data-pressed],
  .start.pending {
    background: var(--home-accent-hover);
    transform: translateY(1px) scale(0.985);
    box-shadow: inset 0 1px 2px rgb(var(--shadow-rgb) / 12%), 0 1px 0 color-mix(in srgb, var(--home-accent) 78%, #011627), 0 3px 8px rgb(var(--shadow-rgb) / 12%);
    transition-duration: 70ms;
  }
  .start:focus-visible {
    outline: 3px solid var(--home-accent);
    outline-offset: 5px;
  }
  /* Pressed before the app finished loading: it waits, visibly. */
  .start.pending {
    cursor: progress;
    animation: none;
  }
  @media (max-width: 480px) {
    .start, .home .btn {
      width: 100%;
      max-width: 22rem;
      justify-content: center;
    }
  }

  /* Hidden but still laid out, so revealing it moves nothing. */
  :global(html.js) .start:not(.ready) {
    visibility: hidden;
    opacity: 0;
  }
  .start.ready {
    /* Release transform after the entrance so hover and press can take over. */
    animation: control-reveal 420ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .start.ready.pending,
  .start.ready[data-pressed] {
    animation: none;
  }
  /* Returning from sign-in: the app replaces the page at once, so the page never shows. */
  :global(html.entering) .home {
    visibility: hidden;
  }
  @keyframes control-reveal {
    from { opacity: 0.88; clip-path: inset(0 8% 0 0 round 999px); transform: translateX(-0.12em); }
    to { opacity: 1; clip-path: inset(0 round 999px); transform: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .home .btn { animation: control-reveal 420ms cubic-bezier(0.16, 1, 0.3, 1) 40ms backwards; }
    .start.ready::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: linear-gradient(105deg, transparent 42%, rgb(255 255 255 / 12%) 49%, transparent 56%);
      background-size: 300% 100%;
      opacity: 0;
      animation: control-sweep 480ms cubic-bezier(0.4, 0, 0.2, 1) 360ms;
    }
    .start.pending::after,
    .start[data-pressed]::after { animation: none; }
  }
  @keyframes control-sweep {
    0% { opacity: 0; background-position: 100% 0; }
    15%, 85% { opacity: 1; }
    100% { opacity: 0; background-position: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .start.ready { animation: none; }
    .start, .home .btn { transition: none; }
    .start:hover, .start:active, .start[data-pressed], .start.pending { transform: none; }
  }
</style>
