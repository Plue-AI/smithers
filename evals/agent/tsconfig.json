{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "inlineSources": false,
    "sourceMap": false,
    // `character/*.test.ts` are `bun:test` suites, so the checked set needs Bun's globals as well as Node's.
    "types": ["bun-types", "node"]
  },
  "include": ["*.ts", "character/*.ts"],
  "exclude": ["PACKAGE.ts"]
}
