{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The suite reaches the review flow, whose walkthrough renderer
    // sources are typed against DOM, as the modules that own them declare.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "inlineSources": false,
    "sourceMap": false,
    // `score.test.ts` and `deterministicReviewer.test.ts` are `bun:test`
    // suites, so the checked set needs Bun's globals as well as Node's.
    "types": ["bun-types", "node"]
  },
  "include": ["*.ts"],
  "exclude": ["PACKAGE.ts"]
}
